@{
    ViewData["Title"] = "About us";
}

<div class="about-hero">
    <div class="about-content">
        <span class="about-label">ABOUT OUR COMPANY</span>

        <h1>Who We Are</h1>

        <p>
            We are a team of passionate people who believe in
            creating modern, reliable and user-friendly solutions.
            Our goal is to provide quality, build trust and make
            every customer's experience better.
        </p>

        <a href="#our-mission" class="about-button">
            Learn More
        </a>
    </div>
</div>

<section id="our-mission" class="about-section">
    <div class="about-image">
        <img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902"
             alt="Our team working together" />
    </div>

    <div class="about-text">
        <h2>Our Mission</h2>

        <p>
            Our mission is to offer innovative solutions
            and excellent service. We work together to meet
            our customers' needs and achieve the best results.
        </p>

        <div class="about-features">
            <div>
                <h3>Quality</h3>
                <p>We focus on quality in everything we do.</p>
            </div>

            <div>
                <h3>Teamwork</h3>
                <p>We believe that great results come from working together.</p>
            </div>

            <div>
                <h3>Innovation</h3>
                <p>We are always looking for new ideas and improvements.</p>
            </div>
        </div>
    </div>
</section>

}
